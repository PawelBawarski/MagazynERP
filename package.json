{
  "name": "stockflow",
  "version": "0.0.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@lucide/angular": "^1.59.0",
    "@ngrx/signals": "^21.1.1",
    "@ngx-translate/core": "^18.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.5.1"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron:dev": "concurrently --kill-others \"ng serve --configuration development\" \"wait-on http://localhost:4200 && electron .\"",
    "electron:build:web": "ng build --configuration production --base-href ./ --output-path dist/stockflow-electron",
    "electron:pack": "npm run electron:build:web && electron-builder --dir --publish never",
    "electron:make": "npm run electron:build:web && electron-builder --publish never",
    "electron:make:windows": "npm run electron:build:web && electron-builder --win nsis --publish never",
    "electron:make:macos": "npm run electron:build:web && electron-builder --mac dmg zip --universal --publish never",
    "electron:make:linux": "npm run electron:build:web && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "private": true,
  "packageManager": "npm@11.21.0",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.stockflow.erp",
    "productName": "StockFlow",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/stockflow-electron/browser/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StockFlow",
      "uninstallDisplayName": "StockFlow"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
